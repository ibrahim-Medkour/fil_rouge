
classDiagram
direction LR

class Utilisateur {
  +int id
  +string nom
  +string prenom
  +string email
  +string telephone
  +string motDePasse
  +inscrire()
  +seConnecter()
  +modifierProfil()
}

class Vehicule {
  +int id
  +string marque
  +string modele
  +string immatriculation
  +int capacite
  +ajouterVehicule()
  +modifierVehicule()
}

class Trajet {
  +int id
  +string villeDepart
  +string villeArrivee
  +datetime dateDepart
  +float prixParPlace
  +int placesDisponibles
  +string statut
  +publierTrajet()
  +modifierTrajet()
  +annulerTrajet()
}

class Reservation {
  +int id
  +datetime dateReservation
  +int nombrePlaces
  +string statut
  +creerReservation()
  +annulerReservation()
  +confirmerReservation()
}

Utilisateur "1" --> "0..*" Vehicule : possede
Utilisateur "1" --> "0..*" Trajet : publie
Utilisateur "1" --> "0..*" Reservation : effectue
Vehicule "1" --> "0..*" Trajet : utilise
Trajet "1" --> "0..*" Reservation : concerne
